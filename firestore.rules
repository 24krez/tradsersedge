rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // User Profile
    match /users/{userId} {
      allow read, write: if isOwner(userId);
    }

    // Top-level collections that use a 'userId' field
    match /missions/{document} {
      allow read, update, delete: if isOwner(resource.data.userId);
      allow create: if isOwner(request.resource.data.userId);
    }
    
    match /mindset_checkins/{document} {
      allow read, update, delete: if isOwner(resource.data.userId);
      allow create: if isOwner(request.resource.data.userId);
    }
    
    match /session_notes/{document} {
      allow read, update, delete: if isOwner(resource.data.userId);
      allow create: if isOwner(request.resource.data.userId);
    }
    
    match /mission_debriefs/{document} {
      allow read, update, delete: if isOwner(resource.data.userId);
      allow create: if isOwner(request.resource.data.userId);
    }
    
    match /discipline_scores/{document} {
      allow read, update, delete: if isOwner(resource.data.userId);
      allow create: if isOwner(request.resource.data.userId);
    }

    match /notification_preferences/{document} {
      // Assuming document ID is userId as per standard practice, but checking field too
      allow read, update, delete: if isOwner(resource.data.userId) || isOwner(document);
      allow create: if isOwner(request.resource.data.userId);
    }
  }
}
