{
  "expo": {
    "name": "Trader's Edge",
    "slug": "traders-edge",
    "scheme": "tradersedge",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/images/TradersEdge_ASappicon_noborder_padded.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "backgroundColor": "#101415"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.24krez.traders-edge",
      "buildNumber": "5",
      "entitlements": {
        "com.apple.security.application-groups": [
          "group.com.24krez.traders-edge.expowidgets"
        ]
      },
      "infoPlist": {
        "CFBundleURLTypes": [
          {
            "CFBundleURLSchemes": [
              "com.24krez.traders-edge",
              "com.googleusercontent.apps.403753278229-trh1i10jghtqebafpru89b27mjth1uc4"
            ]
          }
        ],
        "NSSupportsLiveActivities": true,
        "NSSupportsLiveActivitiesFrequentUpdates": true
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#101415",
        "foregroundImage": "./assets/images/TradersEdge_ASappicon_noborder.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.x24krez.tradersedge"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-localization",
      [
        "expo-notifications",
        {
          "sounds": []
        }
      ],
      [
        "@bacons/apple-targets",
        {}
      ]
    ]
  }
}
